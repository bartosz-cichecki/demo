FROM php:8.3.30-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip libzip-dev zlib1g-dev libicu-dev libpq-dev \
  && docker-php-ext-install pdo pdo_mysql pdo_pgsql zip intl opcache \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.9.7 /usr/bin/composer /usr/bin/composer
COPY docker/php/php.ini /usr/local/etc/php/conf.d/99-app.ini

# Create non-root user
RUN useradd -u 1000 -m appuser \
  && mkdir -p /var/www/app \
  && chown -R appuser:appuser /var/www/app

WORKDIR /var/www/app

# Copy application code
COPY --chown=appuser:appuser app/composer.json app/composer.lock ./

USER appuser

# Install dependencies
RUN composer install --no-dev --optimize-autoloader --no-scripts

# Copy application source
COPY --chown=appuser:appuser app/ ./

# Run post-install scripts
RUN composer run-script post-install-cmd --no-dev || true

# Clear and warmup cache
RUN php bin/console cache:clear --env=prod --no-debug \
    && php bin/console cache:warmup --env=prod --no-debug

EXPOSE 9000
